# ToN Stats Server Configuration
# Copy this file to .env and edit the values

# Database connection
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://ton_user:your_password_here@localhost:5432/ton_stats

# Security - CHANGE THESE IN PRODUCTION!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-character-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Cloudflare Turnstile
# Get these from: https://dash.cloudflare.com/ -> Turnstile
TURNSTILE_SITE_KEY=your-site-key-here
TURNSTILE_SECRET_KEY=your-secret-key-here

# Server settings
HOST=127.0.0.1
PORT=8000
DEBUG=false

# CORS - comma separated list of allowed origins
ALLOWED_ORIGINS=https://your-domain.com

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
